# =============================================================================
#  Конфигурация проекта vpn-https-debian (Xray VLESS + REALITY)
#  Скопируйте в config.env и отредактируйте:  cp config.env.example config.env
#  Файл config.env исключён из git (.gitignore).
# =============================================================================

# --- Сервер -------------------------------------------------------------------
# Что ставить адресом сервера в ссылки vless://:
#   "ip"     — публичный IP (по умолчанию): не зависит от DNS — работает, даже если
#              у клиента DNS отдаёт устаревший/неверный ответ;
#   "domain" — VPN_DOMAIN: при смене IP достаточно поменять A-запись, ссылки
#              у клиентов останутся рабочими.
LINK_ADDRESS="ip"

# Домен (только для LINK_ADDRESS="domain"). Сертификат для него НЕ нужен —
# REALITY использует сертификат сайта-маскировки.
VPN_DOMAIN=""

# Публичный IPv4 сервера для ссылок. Пусто = IP интерфейса WAN_IF, а если там
# внутренний адрес (VPS за NAT хостера, например 192.168.x.x) — определяется
# автоматически через api.ipify.org / ifconfig.me.
PUBLIC_IPV4=""

# Внешний сетевой интерфейс. Узнать: ip route get 1.1.1.1  (слово после "dev")
WAN_IF="enp1s0"

# Адреса на интерфейсе WAN_IF. Пусто = определить автоматически.
WAN_IPV4=""
WAN_IPV6=""

# --- Администрирование --------------------------------------------------------
# Непривилегированный пользователь с sudo, под которым вы будете входить по SSH.
ADMIN_USER="sysadmin"

# Публичный SSH-ключ администратора (ed25519). Вход по паролю будет ЗАПРЕЩЁН.
ADMIN_SSH_PUBKEY="ssh-ed25519 AAAA...replace-me... admin@workstation"

# Порт SSH. Нестандартный порт снижает шум в логах (это не защита сама по себе).
SSH_PORT="2222"

# Адреса/сети, с которых разрешён SSH (через пробел). Пусто = всем
# (с rate-limit и fail2ban). Рекомендуется указать свои IP / bastion.
SSH_ALLOW_FROM=""

# --- Xray / REALITY -----------------------------------------------------------
# Версия Xray-core: "latest" или конкретная, например "v26.10.21".
# Начиная с v26.9.9 сервер отклоняет клиентов без постквантового X25519MLKEM768
# (старые сборки Hiddify и т.п. получают таймаут). Если обновить клиентов нельзя,
# временно закрепите "v26.7.28" — но это старая версия без свежих исправлений,
# а такие клиенты легче распознаются DPI. Лучше обновить клиентов.
XRAY_VERSION="latest"

# Порт. 443 — стандартный HTTPS, выглядит естественнее всего.
XRAY_PORT="443"

# Транспорт поверх REALITY:
#   "xhttp"  — трафик идёт как обычные HTTP/2-запросы к сайту (по умолчанию).
#              Устойчивее к «замораживанию» долгих соединений и анализу их
#              формы. Клиенты — только на ядре Xray: v2rayNG, v2rayN, V2Box,
#              FoXray и т.п. Клиенты на sing-box (Hiddify, NekoBox, Karing) XHTTP
#              не поддерживают.
#   "vision" — VLESS + XTLS Vision поверх TCP: максимальная скорость и
#              минимум CPU, поддерживается всеми клиентами.
# После смены — sudo ./scripts/03-install-vpn.sh и новые ссылки всем пользователям.
XRAY_TRANSPORT="xhttp"

# Режим XHTTP, который попадёт в ссылки (сервер принимает любой):
#   auto       — клиент выбирает сам (с REALITY это один длинный поток stream-one);
#   packet-up  — загрузка серией коротких POST-запросов: лучше всего против
#                «замораживания» соединений после первых килобайт, но медленнее;
#   stream-up / stream-one — потоковые режимы, быстрее.
XHTTP_MODE="auto"

# Путь XHTTP (как у URL на сайте). Пусто = стабильный случайный, выводится из ключа сервера.
XHTTP_PATH=""

# Сайт, под который маскируется сервер (ОБЯЗАТЕЛЬНО). Для постороннего
# наблюдателя и для активных проверок сервер выглядит как этот сайт: отдаёт
# его настоящий сертификат и страницы. Требования (подробно — docs/02):
#   * TLS 1.3 и HTTP/2, без редиректа на другой домен;
#   * НЕ за Cloudflare/Akamai и т.п. CDN, НЕ заблокирован в РФ;
#   * лучше — сайт, размещённый в той же стране / у того же хостера, что и VPS;
#   * не используйте «популярные» варианты из инструкций в интернете
#     (www.microsoft.com, www.google.com и т.п.) — они примелькались.
# Формат: домен или домен:порт. Проверка: scripts/03-install-vpn.sh делает это сам.
REALITY_DEST=""

# Свой сайт-заглушка вместо чужого сайта: "yes" — на сервере поднимается nginx с
# небольшим сайтом на VPN_DOMAIN и сертификатом Let's Encrypt, и REALITY маскируется
# под него (REALITY_DEST и REALITY_SERVER_NAMES тогда не используются).
# Плюсы: SNI = ваш домен, который действительно указывает на этот IP; не зависите
# от чужого сайта. Нужно: VPN_DOMAIN с A-записью на этот сервер, ACME_EMAIL,
# открытый порт 80 (02-firewall.sh откроет его сам). Подробно — docs/02-vpn-server.md.
REALITY_SELF_SITE="no"
ACME_EMAIL=""
# Название на сайте-заглушке. Пусто = из домена (softiai.shop -> "Softiai").
SITE_TITLE=""
# Внутренний порт сайта (только 127.0.0.1, снаружи недоступен).
SELF_SITE_PORT="8443"

# --- Запасной вход через CDN (Cloudflare) ---
# Клиент подключается к Cloudflare (его IP не блокируют — через них работают тысячи
# сайтов), Cloudflare пересылает запросы на этот сервер. Нужен REALITY_SELF_SITE="yes".
# В Cloudflare: домен подключён, запись A "cdn" -> публичный IP сервера, облако
# ОРАНЖЕВОЕ (Proxied), SSL/TLS = Full (strict). Подробно — docs/07-cdn.md.
CDN_ENABLE="no"
CDN_DOMAIN=""            # например, cdn.softiai.shop
# Внутренний порт входа Xray для CDN (только 127.0.0.1).
CDN_XRAY_PORT="10444"
# Путь XHTTP для CDN. Пусто = стабильный случайный, выводится из ключа сервера.
CDN_PATH=""

# Имена (SNI), которые принимает сервер. Пусто = домен из REALITY_DEST.
# Можно несколько через пробел, если сертификат сайта их покрывает.
REALITY_SERVER_NAMES=""

# TLS-отпечаток клиента в ссылках: chrome (по умолчанию), firefox, safari, ios, edge.
CLIENT_FINGERPRINT="chrome"

# Порт API Xray (статистика пользователей). Слушает только 127.0.0.1.
XRAY_API_PORT="10085"

# Блокировать BitTorrent через VPN (жалобы правообладателей приходят хостеру,
# за них могут отключить сервер). yes/no
BLOCK_BITTORRENT="yes"

# Журнал доступа Xray (кто и КАКИЕ САЙТЫ открывал). По умолчанию выключен ради
# приватности пользователей. yes/no
XRAY_ACCESS_LOG="no"

# Уровень журнала Xray: warning (обычно), info или debug — для диагностики
# подключений: ошибки REALITY (неверный ключ, SNI, время) видны только на debug.
# Применить: sudo ./scripts/03-install-vpn.sh. Не оставляйте debug надолго.
XRAY_LOGLEVEL="warning"

# --- Исключения из туннеля (для клиентских конфигов) ------------------------
# Домены/сети, которые клиент открывает напрямую, мимо VPN. Используется в
# `vpn-user.sh client-config`. Пример: split-exclude.example.txt.
SPLIT_EXCLUDE_FILE="/opt/vpn-https-debian/split-exclude.txt"

# Все российские сайты и IP — напрямую (geosite:category-ru, geoip:ru, .ru, .рф)
# в клиентском конфиге. yes/no
CLIENT_DIRECT_RU="no"
