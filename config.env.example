# =============================================================================
#  Конфигурация проекта vpn-https-debian
#  Скопируйте в config.env и отредактируйте:  cp config.env.example config.env
#  Файл config.env содержит секреты — он исключён из git (.gitignore).
# =============================================================================

# --- Сервер -------------------------------------------------------------------
# Полное доменное имя VPN-сервера. A/AAAA-запись должна указывать на сервер
# ДО запуска 03-install-vpn.sh (нужно для выпуска сертификата Let's Encrypt).
VPN_DOMAIN="vpn.example.com"

# E-mail для уведомлений Let's Encrypt (истечение сертификата и т.п.).
ACME_EMAIL="admin@example.com"

# Внешний сетевой интерфейс (40G NIC). Узнать: ip -br link / ip route get 1.1.1.1
WAN_IF="enp65s0f0"

# Публичный IPv4 сервера (используется для SNAT — дешевле MASQUERADE на 40G).
# Оставьте пустым, чтобы определить автоматически по WAN_IF.
WAN_IPV4=""

# --- Администрирование --------------------------------------------------------
# Непривилегированный пользователь с sudo, под которым вы будете входить по SSH.
ADMIN_USER="sysadmin"

# Публичный SSH-ключ администратора (ed25519). Вход по паролю будет ЗАПРЕЩЁН.
ADMIN_SSH_PUBKEY="ssh-ed25519 AAAA...replace-me... admin@workstation"

# Порт SSH. Нестандартный порт снижает шум в логах (это не защита сама по себе).
SSH_PORT="2222"

# Список адресов/сетей, с которых разрешён SSH (через пробел).
# Пусто = SSH открыт всем (с rate-limit и fail2ban). Рекомендуется указать
# офисные IP / bastion / сеть управления дата-центра.
SSH_ALLOW_FROM=""

# Разрешить SSH ещё и изнутри VPN-туннеля (из VPN_NET4). yes/no
SSH_FROM_VPN="yes"

# --- VPN ----------------------------------------------------------------------
# Адресное пространство клиентов. /16 = до ~65 тыс. одновременных клиентов.
VPN_NET4="10.88.0.0/16"
# Адрес сервера внутри VPN (первый адрес сети) — сюда смотрит DNS клиентов.
VPN_GW4="10.88.0.1"

# IPv6 внутри туннеля (ULA + NAT66). Рекомендуется оставить включённым:
# если сервер не выдаст клиенту IPv6, трафик к IPv6-сайтам может пойти мимо
# VPN (IPv6-утечка). Пусто = IPv6 в туннеле отключён.
VPN_NET6="fd88:88::/48"

# Максимум одновременных клиентов и сессий на одного пользователя.
MAX_CLIENTS="4096"
MAX_SAME_CLIENTS="3"

# Двухфакторная аутентификация (пароль + TOTP из Google Authenticator и т.п.).
ENABLE_OTP="yes"

# Маскировка (camouflage): без секрета в URL сервер отвечает как обычный
# веб-сервер (404), и сканеры не видят, что это VPN.
# Клиент подключается к https://VPN_DOMAIN/?<CAMOUFLAGE_SECRET>
# Сгенерировать: openssl rand -hex 16
CAMOUFLAGE_SECRET=""

# --- Исключения из туннеля (split exclude) ---------------------------------------
# Файл со списком доменов/сетей, трафик к которым идёт мимо VPN.
# Пример: split-exclude.example.txt. Нет файла — весь трафик в туннеле.
# Применить изменения: sudo ./scripts/update-split-routes.sh
SPLIT_EXCLUDE_FILE="/opt/vpn-https-debian/split-exclude.txt"
# До какой подсети расширять найденные IP (CDN меняют адреса внутри подсети).
SPLIT_V4_PREFIX="24"
SPLIT_V6_PREFIX="48"
# Сколько дней помнить ранее найденные адреса домена.
SPLIT_KEEP_DAYS="7"
# Лимит маршрутов: клиенты (особенно мобильные) не принимают слишком много.
SPLIT_MAX_ROUTES="200"

# --- Производительность -------------------------------------------------------
# MTU туннеля. 1420 безопасно для DTLS поверх Ethernet 1500.
# Если в ДЦ включены jumbo frames на всём пути — можно поднять, но клиенты в
# интернете почти всегда за MTU 1500, так что оставьте 1420.
VPN_MTU="1420"
